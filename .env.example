# Salescale backend configuration.
#
# Every value here has a working default (see backend/app/config.py), so the
# app runs with NO .env at all — it falls back to a local SQLite database and
# disabled integrations. Set these only to enable the corresponding feature.
# Copy to backend/.env to use.

# --- Core ---
# Defaults to a local SQLite file. Set to a Postgres URL for production.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/salescale

# REQUIRED in production — signs auth tokens. The default is a known dev value;
# leaving it unset lets anyone forge sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# REQUIRED to connect ad platforms — encrypts stored OAuth tokens at rest.
# Without it, saving a Meta/Google connection raises at runtime. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# Origin allowed by CORS (the web frontend). Ignored when DESKTOP_MODE=1,
# which the Electron desktop app sets automatically.
# FRONTEND_ORIGIN=http://localhost:5173

# Set to 1 ONLY when the backend sits behind a trusted reverse proxy / load
# balancer, so rate limiting reads the real client IP from X-Forwarded-For.
# Off by default so clients can't spoof that header to dodge limits. Turn on
# for the hosted deploy (nginx / cloud LB), never for desktop/direct.
# TRUST_FORWARDED_FOR=1

# --- Meta (Facebook/Instagram) Ads integration ---
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=

# --- Google Ads integration ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_DEVELOPER_TOKEN=
# GOOGLE_LOGIN_CUSTOMER_ID=

# --- AI insights (Claude API, server-side only) ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-4-8

# --- Transactional email ---
# Resend (preferred): the sender domain must be verified in Resend, and
# EMAIL_DEFAULT_FROM_ADDRESS must be on that domain.
# RESEND_API_KEY=
# EMAIL_DEFAULT_FROM_ADDRESS=no-reply@yourdomain.com
# SMTP fallback (used only if RESEND_API_KEY is unset):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Require users to verify their email before they can log in (default off):
# REQUIRE_EMAIL_VERIFICATION=true

# --- Two-factor auth ---
# TOTP (authenticator apps) and email 2FA need nothing here. Phone/SMS 2FA
# needs Twilio; without all three, SMS enrollment returns 503 (TOTP + email
# still work).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15555550100

# --- Social login (Sign in with Google / Meta) ---
# Reuses the same OAuth apps as the ad integrations above; register these
# extra redirect URIs on them: https://<api>/api/auth/oauth/google/callback
# and https://<api>/api/auth/oauth/meta/callback. Needs GOOGLE_CLIENT_ID/SECRET
# and META_APP_ID/SECRET (set above). Optional dedicated overrides:
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=
# META_LOGIN_APP_ID=
# META_LOGIN_APP_SECRET=
# OAuth callbacks redirect back to the web app here:
# APP_BASE_URL=https://app.yourdomain.com
