# Deploy-level config (domains + reverse-proxy contact). Copy to .env in this
# directory — used by BOTH docker-compose.prod.yml (Caddy) and
# docker-compose.traefik.yml (reusing an existing Traefik). Separate from
# backend/.env, which holds the app's own secrets (DATABASE_URL, JWT_SECRET,
# etc. — see ../.env.example).

# The web app's public domain — point an A record here before first deploy.
APP_DOMAIN=app.yourdomain.com

# The backend API's public domain — point an A record here too. Sign-in and
# ad-connect OAuth both redirect through this host.
API_DOMAIN=api.yourdomain.com

# Baked into the frontend's static build at image-build time. Must match
# API_DOMAIN over HTTPS.
VITE_API_URL=https://api.yourdomain.com

# Let's Encrypt sends expiry/problem notices here. Any address you read.
# ONLY used by docker-compose.prod.yml (Caddy) — the Traefik variant reuses
# the existing Traefik's own ACME contact and ignores this.
ACME_EMAIL=you@yourdomain.com
